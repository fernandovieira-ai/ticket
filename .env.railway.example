# Railway Environment Variables - Configuração Otimizada
# Copie estas variáveis para o Railway Dashboard → Variables

# ===== STORAGE PERSISTENTE =====
RAILWAY_VOLUME_MOUNT_PATH=/app/storage
STORAGE_TYPE=volume

# ===== UPLOAD LIMITS =====
MAX_FILE_SIZE=25000000
MAX_FILES_PER_UPLOAD=5

# ===== PERFORMANCE =====
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ===== SECURITY =====
# Adicione domínios permitidos se necessário
# ALLOWED_ORIGINS=https://painel.digitalrf.com.br

# ===== AGENTE IA =====
# Chave secreta para autenticar as chamadas de cron (qualquer string aleatoria)
CRON_SECRET=troque-por-uma-string-aleatoria-segura
# URL do agente-core HTTP (opcional, deixe vazio para modo standalone)
AGENT_CORE_URL=
# Chave da Anthropic (obrigatoria no modo standalone)
ANTHROPIC_API_KEY=sk-ant-...
# Chave de criptografia (AES-256-GCM) das senhas de banco dos clientes cadastrados
# (agente_clientes.db_senha / agente_clientes_bases.db_senha). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 caracteres hex (32 bytes). NUNCA trocar depois de ter clientes cadastrados sem antes
# re-criptografar os dados existentes com a chave nova — senhas antigas ficam ilegiveis.
AGENTE_ENCRYPTION_KEY=troque-por-uma-chave-hex-de-64-caracteres

# ===== CRON: Configurar no Railway Dashboard =====
# Nome    : Varredura Agentes IA
# Schedule: */30 * * * *
# URL     : https://seu-dominio.railway.app/api/cron/agentes/varrer
# Metodo  : GET
# Header  : x-cron-secret = <valor de CRON_SECRET acima>

# ===== MONITORING =====
ENABLE_STORAGE_LOGS=true
BACKUP_ENABLED=true

# ===== DATABASE (já configurado) =====
# DATABASE_URL=postgresql://...
# NEXTAUTH_SECRET=...
# NEXTAUTH_URL=...

# ===== EMAIL (já configurado) =====
# SMTP_HOST=...
# SMTP_PORT=...
# etc...

# ===== OPCIONAL: BACKUP EXTERNO =====
# AWS_S3_BACKUP_BUCKET=digitalrf-backup
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...